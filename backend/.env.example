# ---------- Groq (LLM) ----------
# Comma-separated pool of Groq keys (from different accounts) for
# automatic rotation + rate-limit tolerance.
# Get keys at: https://console.groq.com
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Legacy single-key fallback (still supported if GROQ_API_KEYS is empty)
GROQ_API=your_groq_api_key_here

# ---------- Pinecone (vector DB) ----------
# Get your API key from: https://www.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here

# ---------- Data storage ----------
DATA_DIR=/tmp/rag-data

# ---------- GitHub OAuth (optional — for private repos) ----------
# Register at https://github.com/settings/developers
# Callback URL must be: <BACKEND_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:5173

# ---------- Supabase (optional — for shareable sessions) ----------
# Create a project at https://supabase.com, run the schema in the SQL editor,
# and grab the service_role key (not the anon key) from Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here
