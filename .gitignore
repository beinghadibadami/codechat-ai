# Root gitignore for both backend and frontend.
# Patterns are depth-agnostic (no leading path) so they match nested
# directories too, e.g. backend/services/__pycache__ as well as backend/__pycache__.

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Frontend ----------
node_modules/
dist/
dist-ssr/
.eslintcache
.cache/
.turbo/
.vite/
*.local

# ---------- Backend (Python) ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.installed.cfg
.venv/
venv/
env/
ENV/
.python-version

# Packaging
build/

# Test/coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Data/runtime storage
/data/
/tmp/
rag-data/

# Large binaries / archives that shouldn't be committed by mistake
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Misc
*.pid
*.seed

# Optional lockfiles (uncomment to ignore lockfiles)
# frontend/yarn.lock
# frontend/pnpm-lock.yaml
# frontend/package-lock.json
# frontend/bun.lockb
